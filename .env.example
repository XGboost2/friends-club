# Neon (or any Postgres) connection string. sslmode=require enables SSL automatically.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Timezone used for "today" and 7-day retention logic.
CLUB_TIMEZONE=Europe/Prague

# Local dev only — Render sets PORT automatically.
PORT=3000

# Resend (https://resend.com) for email OTPs. Without it, codes print to the server console (dev mode).
RESEND_API_KEY=
# Sender identity Resend allows for your account.
EMAIL_FROM=Friends Club <onboarding@resend.dev>
# Shown in the OTP subject line and email body.
SITE_NAME=Friends Club
