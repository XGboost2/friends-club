# Neon (or any Postgres) connection string. sslmode=require enables SSL automatically.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Timezone used for "today" and retention logic.
CLUB_TIMEZONE=Europe/Prague

# Local dev only — Render/Railway sets PORT automatically.
PORT=3000

# Clerk (https://clerk.com) — identity provider for players.
# Dev instance: pk_test_... / sk_test_...
# Production (custom domain) instance: pk_live_... / sk_live_...
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
